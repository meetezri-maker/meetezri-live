# ---------------------------------------------------------------------------
# Integration-test environment — TEMPLATE.
#
# Copy this file to `.env.test` (which is git-ignored) before running:
#
#     cp apps/api/.env.test.example apps/api/.env.test
#     pnpm --filter @meetezri/api test:integration:up
#     pnpm --filter @meetezri/api test:integration
#
# The values below match `infra/docker/docker-compose.test.yml` exactly, so the defaults work
# as-is against the disposable local container. They are throwaway credentials for a database
# that lives in tmpfs and is destroyed with the container — they are not secrets, but the real
# `.env.test` still stays out of version control so nobody can drift it toward a shared host.
#
# NEVER point these at a managed database. `assertSafeTestDatabaseUrl()` refuses anything that is
# not a local, disposable database named `meetezri_test`, and integration tests deliberately have
# NO fallback to `DATABASE_URL` — that variable points at production Supabase.
# ---------------------------------------------------------------------------

# Connection used by Prisma at runtime during integration tests.
TEST_DATABASE_URL="postgresql://meetezri_test:meetezri_test@localhost:5433/meetezri_test"

# Direct (non-pooled) connection used by `prisma migrate deploy`. For the local container this is
# the same endpoint; it is kept separate because the Prisma schema declares `directUrl`, and
# because a pooled URL must never be used for migrations.
TEST_DIRECT_URL="postgresql://meetezri_test:meetezri_test@localhost:5433/meetezri_test"
