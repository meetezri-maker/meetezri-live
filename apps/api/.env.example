PORT=3001
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret
STRIPE_SECRET_KEY=your_stripe_secret
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
REDIS_URL=redis://redis:6379
AI_SERVICE_URL=http://ai:8000
# Public web app URL (fallback when request has no Origin/Referer, e.g. scripts).
# Local dev: keep WEB_BASE_URL on localhost; set CLIENT_URL to your deployed SPA so
# admin invite emails use production links (see getInviteRedirectBaseUrl in src/lib/webBaseUrl.ts).
WEB_BASE_URL=http://localhost:5173
CLIENT_URL=https://sub.talktosolace2.ai
# Public URL for email template assets (logos). Defaults to WEB_BASE_URL / CLIENT_URL.
# EMAIL_ASSET_BASE_URL=https://sub.talktosolace2.ai

# Email (transactional mail from the API — admin "email user", verification, etc.)
# SMTP_USER must be allowed to send; SMTP_FROM is the visible From (use a product address if your host allows):
# SMTP_FROM="Solace <noreply@solace.health>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DEBUG_API_TIMING=true
