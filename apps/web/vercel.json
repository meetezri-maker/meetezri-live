{
  "installCommand": "npx --yes pnpm@10.33.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@10.33.0 run build",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/onboarding/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/signup",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/verify-email",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/forgot-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/auth/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/invite/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/landing-page",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/onboarding",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/onboarding/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/profile",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/profile/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/error",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/error/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dev",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dev/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/_public/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://meetezri-live-api.vercel.app/api/:path*"
    },
    {
      "source": "/resources",
      "destination": "https://meetezri-live-api.vercel.app/resources"
    },
    {
      "source": "/resources/:slug",
      "destination": "https://meetezri-live-api.vercel.app/resources/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://meetezri-live-api.vercel.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://meetezri-live-api.vercel.app/robots.txt"
    },
    {
      "source": "/how-it-works",
      "destination": "/_public/how-it-works.html"
    },
    {
      "source": "/talk-it-out",
      "destination": "/_public/talk-it-out.html"
    },
    {
      "source": "/about",
      "destination": "/_public/about.html"
    },
    {
      "source": "/safety",
      "destination": "/_public/safety.html"
    },
    {
      "source": "/pricing",
      "destination": "/_public/pricing.html"
    },
    {
      "source": "/privacy",
      "destination": "/_public/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/_public/terms.html"
    },
    {
      "source": "/early-access",
      "destination": "/_public/early-access.html"
    },
    {
      "source": "/login",
      "destination": "/spa.html"
    },
    {
      "source": "/signup",
      "destination": "/spa.html"
    },
    {
      "source": "/verify-email",
      "destination": "/spa.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/spa.html"
    },
    {
      "source": "/reset-password",
      "destination": "/spa.html"
    },
    {
      "source": "/auth/:action(callback|activate-account)",
      "destination": "/spa.html"
    },
    {
      "source": "/invite/create-password",
      "destination": "/spa.html"
    },
    {
      "source": "/landing-page",
      "destination": "/spa.html"
    },
    {
      "source": "/onboarding",
      "destination": "/spa.html"
    },
    {
      "source": "/onboarding/:path*",
      "destination": "/spa.html"
    },
    {
      "source": "/app",
      "destination": "/spa.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/:page(login|credentials|two-factor-auth|super-admin-dashboard|org-admin-dashboard|team-admin-dashboard|user-management|user-segmentation|team-role-management|companion-management|ai-avatar-manager|conversation-transcripts|expert-reviews|crisis-dashboard|crisis-monitoring|crisis-event-details|crisis-follow-up-queue|crisis-protocol|analytics|usage-overview|usage-analytics|session-analytics|engagement-metrics|retention-metrics|feature-adoption|onboarding-analytics|reports-analytics|avatar-selection-analytics|content-management|wellness-tools-cms|wellness-content-cms|wellness-content-library|wellness-tool-editor|exercise-library|content-performance|nudge-center|nudge-management|nudge-templates|nudge-scheduler|nudge-performance|gamification|wellness-challenges|badge-manager|communications|notifications-center|manual-notifications|email-templates|push-notifications|support-tickets|community-management|live-sessions-monitor|session-recordings|system-health-enhanced|system-health-dashboard|error-tracking|system-settings|system-settings-enhanced|global-configuration|feature-flags|api-management|integration-settings|branding-customization|ab-testing|billing|billing-subscriptions|package-manager|payg-transactions|security-settings|compliance-dashboard|hipaa-compliance|data-privacy-controls|data-retention-privacy|audit-logs|system-logs|legal-documentation|data-export|backup-recovery)",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/user-details-enhanced/:userId",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/user-analytics/:section(moods|journals|sleep|habits)",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/user-analytics/:section(moods|journals|sleep|habits)/:userId",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/content-hub",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/content-hub/:id",
      "destination": "/spa.html"
    },
    {
      "source": "/admin/content-hub/:id/preview",
      "destination": "/spa.html"
    },
    {
      "source": "/profile/:userId",
      "destination": "/spa.html"
    },
    {
      "source": "/error/:page(404|500|offline|maintenance|permission-denied|no-device-access|trial-expired)",
      "destination": "/spa.html"
    },
    {
      "source": "/dev/:page(sara-avatar-lab|sara-rfv2-lab)",
      "destination": "/spa.html"
    }
  ]
}
