VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional. Leave unset in local dev to use same-origin `/api` (Vite proxies to the API — see vite.config.ts).
# Set explicitly if the web app should call the API on another host/port (bypasses the dev proxy):
# VITE_API_URL=http://localhost:3001/api
# Base URL used for Supabase email verification redirects.
# - Local: http://localhost:5173
# - Production: https://sub.talktosolace2.ai
VITE_WEB_BASE_URL=http://localhost:5173
# Production API — optional. Leave unset to use same-origin `/api` (proxied by Vercel to the API deployment).
# VITE_API_URL=https://meetezri-live-api.vercel.app/api

# ── Ezri AI Agent (Hugging Face Space: REST + WebSocket) ─────────────────────
# WebSocket URL must be the path only (no query string). The app adds:
# ?brain_provider=&tts_provider=&stt_provider=&userid=&session_id=&voice=
VITE_EZRI_API_BASE=https://meetezri-ezri-ai-agent.hf.space
VITE_EZRI_WS_BASE=wss://meetezri-ezri-ai-agent.hf.space/api/v1/ws/active
VITE_DEFAULT_BRAIN_PROVIDER=groq
VITE_DEFAULT_TTS_PROVIDER=pocket_tts
VITE_DEFAULT_STT_PROVIDER=runpod
# Voice when companion name doesn’t match Alex/Jordan/Maya/Sarah (optional overrides below).
VITE_DEFAULT_EZRI_VOICE=af_sky
# Pocket TTS / Kokoro — must match production Ezri agent voices
VITE_EZRI_VOICE_FEMALE=eponine
VITE_EZRI_VOICE_MALE=jean

# Local Ezri instead of HF (uncomment and point VITE_EZRI_* here):
# VITE_EZRI_API_BASE=http://localhost:8000
# VITE_EZRI_WS_BASE=ws://localhost:8000/api/v1/ws/active